# aontu:render/lang/markdown --- THE MARKDOWN PROFILE. No declarations to
# lower, so this is the text profile plus markdown's own two: the HTML
# comment form and the template marker its files carry. EXPERIMENTAL
# until the distribution layer can version it by canon-hash.

@"aontu:render"

aontu: render: Lang: lang: "markdown"
aontu: render: Lang: indent: { unit:" " width:2 }
aontu: render: Lang: comment: block: { open:"<!--" close:"-->" }
aontu: render: Lang: template: { marker:"<!---" ext: ["md" "markdown"] }
