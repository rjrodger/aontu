# gen-ts-cmp.aon --- gen-ts.aon's output, written as a COMPONENT TREE
# rather than as an aontu:code instance.
#
# The same model, the same bytes, the other road: `render --at out`
# lowers the tree to units, so a folder is a path segment and a file's
# `line` children are its text. The two files together are the measure
# the register cites -- what each spelling costs for one job.
@"./model.aon"

%ts_field = emit(_, {
  match: n: string
  body: [
    line(
      "  " + .n + match(.req, true, "", false, "?") + ": "
      + match(.t, "string", "string", "integer", "number")
    )
  ]
})

%ts_record = emit(_, {
  match: name: string
  body: [
    line("")
    line("export interface " + .name + " {")
    emit(.fields, %ts_field)
    line("}")
  ]
})

out: file("types.ts", [
  line("// Code generated by aontu from model.aon. DO NOT EDIT.")
  emit($.records, %ts_record)
])
