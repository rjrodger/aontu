# gen-ts.aon --- TypeScript interfaces from model.aon, as an
# aontu:code instance.
#
# This generator reads NEITHER the `go` nor the `sql` slice: a
# TypeScript property keeps the wire name. Optionality becomes `?`,
# which is `match` on a boolean rather than anything clever. The
# shape is gen-go.aon's -- a rule set over the records, a nested one
# over each record's fields, two fragments -- and the unit names no
# profile, so `aontu render` folds it under the bundled text profile:
# two spaces per depth.
@"./model.aon"

%ts_field = emit(_, {
  match: n: string
  body: [
    {
      k: "line"
      at: 1
      n: [
        .n + match(.req, true, "", false, "?") + ": "
        + match(.t, "string", "string", "integer", "number")
      ]
    }
  ]
})

%ts_record = emit(_, {
  match: name: string
  body: [
    k: "blank"
    "export interface " + .name + " {"
    emit(.fields, %ts_field)
    "}"
  ]
})

units: ts: {
  path: "types.ts"
  lang: "typescript"
  decls: [
    { k:"frag" n:["// Code generated by aontu from model.aon. DO NOT EDIT."] }
    { k:"frag" n:emit($.records, %ts_record) }
  ]
}
