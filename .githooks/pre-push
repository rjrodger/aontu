#!/bin/sh
# ADR-032: the comment gate runs before the push, not after CI is spent.
# Bypass with `git push --no-verify`; CI runs the same checker anyway.

set -e

REPO=$(git rev-parse --show-toplevel)

if ! command -v node >/dev/null 2>&1; then
	echo "pre-push: node is not on PATH, skipping the comment gate (ADR-032)" >&2
	exit 0
fi

exec node "$REPO/ts/scripts/comment-gate.cjs"
