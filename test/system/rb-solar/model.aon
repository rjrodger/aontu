# The Solar System API, as a model.
#
# This file is the ONE source every generated file reads: the routes,
# the migrations, the models, both sets of controllers, the views and
# the seeds are all facts stated here. `aontu render --coverage` names
# anything below that no generated file consumed, so a field added and
# forgotten is reported rather than rotting.
#
# The API is the reference's, not ours: `ref/README.md` says what it is
# held to, and `ref/validate.ts` is what runs.

service: name: "solar"
service: title: "Solar System"

# The API prefix, and the port `check.sh` and the reference agree on.
service: api: "/api"
service: port: 8901

# The page a bare `/` shows.
service: root: "planets#index"

# The seed data is the reference's own, included as DATA rather than
# copied: an include whose extension is `.json` is config data, so the
# generator walks the same eight planets and twenty-one moons the
# reference app serves.
seed: @"./ref/solar.data.json"

# --- what a field is -------------------------------------------------
#
# A field's KIND is `string`, `float` or `boolean`. What each becomes
# in a target -- a migration's column type, a form's input -- is the
# generator's business and is spelled there with `match()`; the model
# says what the field IS.
#
# EVERY FIELD ANSWERS `pk`, including with `false`. Absence is not an
# answer a rule table can read: an `emit` rule's `match` admits a node
# the key is missing from, where `filter` refuses it
# ([BUGS.md §88](../../use-cases/BUGS.md)), so a generator that asked
# `{ pk:true }` of a field with no `pk` would take that rule for every
# field. Stating it is better modelling anyway.

# EVERY FIELD STATES ITS JSON NAME. The wire says `terraformState`
# where the column says `terraform_state`, and `planet_id` either way;
# what a field is called in a target is a fact about the model rather
# than a rule in a template, so it is written down. A generator that
# derived one from the other would be guessing, and would be wrong
# three times out of seven here.

# --- the entities ----------------------------------------------------
#
# A list, not a map: the order is the order the migrations run in, and
# a parent's table must exist before the child's foreign key.
entity: [
  {
    id: "planet"
    class: "Planet"
    table: "planets"
    controller: "planets"
    param: "planet_id"
    title: "Planet"
    plural: "Planets"
    label: "name"

    # THE URL SHAPES ARE FACTS ABOUT THE API, so they are stated rather
    # than assembled from the parent chain by a rule. An action's path
    # is `api_item` and its name; nothing else is derived.
    api_collection: "/api/planet"
    api_item: "/api/planet/:planet_id"
    ui_collection: "/planets"
    ui_item: "/planets/:planet_id"
    ui_collection_helper: "planets"
    ui_item_helper: "planet"

    field: [
      { name:"id" json:"id" kind:"string" required:true pk:true }
      { name:"name" json:"name" kind:"string" required:true pk:false }
      { name:"kind" json:"kind" kind:"string" required:true pk:false }
      { name:"diameter" json:"diameter" kind:"float" required:true pk:false }
      { name:"terraform_state" json:"terraformState" kind:"string" pk:false }
      { name:"forbid_state" json:"forbidState" kind:"string" pk:false }
      { name:"forbid_reason" json:"forbidReason" kind:"string" pk:false }
    ]

    # THE SEED ROWS FOR THIS ENTITY, each carrying its class. The join
    # happens here, where `$.seed.planet` is an absolute path and the
    # class is a literal: a generator could not do it, because a nested
    # dispatch cannot see the entity the outer one matched.
    rows: form($.seed.planet, _ & { class:"Planet" })

    # WHAT HANGS OFF THIS ENTITY. Each row carries the association's
    # name, the class on the other end and the key it joins on, because
    # that is what the `has_many` line needs and a nested dispatch can
    # read nothing else.
    children: [{ name:"moons" class:"Moon" fk:"planet_id" cascade:true }]

    # No index of its own: the primary key already has one.
    index: []

    # An action is a POST beside the record that sets one state field
    # from the flags its body carries. The rules are tried in order and
    # the first that fires wins, which is why they are a list.
    action: [
      {
        name: "terraform"
        path: "/api/planet/:planet_id/terraform"
        controller: "planets"
        state: "terraform_state"
        initial: "idle"

        # KEEP means the current value is the starting point, so an
        # action with no flag set leaves the record as it was.
        keep: true
        accept: [{ name:"start" kind:"boolean" } { name:"stop" kind:"boolean" }]
        rule: [{ when:"start" then:"terraforming" } { when:"stop" then:"idle" }]
      }
      {
        name: "forbid"
        path: "/api/planet/:planet_id/forbid"
        controller: "planets"
        state: "forbid_state"
        initial: "allowed"

        # Not KEEP: an unforbidden planet is allowed, whatever it was.
        keep: false
        reason: "forbid_reason"
        accept: [{ name:"forbid" kind:"boolean" } { name:"why" kind:"string" }]
        rule: [{ when:"forbid" then:"forbidden" from:"why" }]
      }
    ]
  }

  {
    id: "moon"
    class: "Moon"
    table: "moons"
    controller: "moons"
    param: "moon_id"
    title: "Moon"
    plural: "Moons"
    label: "name"

    api_collection: "/api/planet/:planet_id/moon"
    api_item: "/api/planet/:planet_id/moon/:moon_id"
    ui_collection: "/planets/:planet_id/moons"
    ui_item: "/planets/:planet_id/moons/:moon_id"
    ui_collection_helper: "planet_moons"
    ui_item_helper: "planet_moon"

    # NESTED UNDER ITS PARENT, and the parent's delete takes it with
    # it: one word here is the route shape, the foreign key, the scope
    # every lookup runs in, and the `dependent: :destroy` that makes
    # test 18 pass.
    parent: "planet"
    parent_class: "Planet"
    parent_param: "planet_id"
    parent_controller: "planets"

    # AN INDEX ROW CARRIES ITS OWN TABLE. Everything a generated line
    # needs must be on the node the line's rule matched: a nested
    # dispatch cannot see the entity the enclosing one matched, and a
    # relative reference inside a call's argument does not resolve
    # there at all -- silently, as an empty selection
    # ([BUGS.md §89](../../use-cases/BUGS.md)).
    index: [{ table:"moons" column:"planet_id" }]

    rows: form($.seed.moon, _ & { class:"Moon" })

    children: []

    field: [
      { name:"id" json:"id" kind:"string" required:true pk:true }
      { name:"name" json:"name" kind:"string" required:true pk:false }
      {
        name: "planet_id"
        json: "planet_id"
        kind: "string"
        required: true
        fk: true
        pk: false
      }
      { name:"kind" json:"kind" kind:"string" required:true pk:false }
      { name:"diameter" json:"diameter" kind:"float" required:true pk:false }
    ]

    action: []
  }
]

# --- the error envelope ----------------------------------------------
#
# `{error, message}` with the reference's own wording: test 13 reads
# the name and looks for "not found" in the message, so the shape and
# the sentence are both part of the API.
error: [
  { name:"NotFoundError" status:404 message:"ENTITY with id 'ID' not found" }
  { name:"ValidationError" status:400 message:"FIELDS" }
  {
    name: "ConflictError"
    status: 409
    message: "ENTITY with id 'ID' already exists"
  }
]
