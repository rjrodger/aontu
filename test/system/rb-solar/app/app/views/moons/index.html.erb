<%# Generated by aontu render from model.aon. Do not edit. %>
<h1>Moons of <%= @scope.id %></h1>
<table>
  <thead>
    <tr>
      <th>id</th>
      <th>name</th>
      <th>planet_id</th>
      <th>kind</th>
      <th>diameter</th>
    </tr>
  </thead>
  <tbody>
    <% @records.each do |record| %>
      <tr>
        <td><%= link_to record.id, planet_moon_path(@scope.id, record.id) %></td>
        <td><%= record.name %></td>
        <td><%= record.planet_id %></td>
        <td><%= record.kind %></td>
        <td><%= record.diameter %></td>
      </tr>
    <% end %>
  </tbody>
</table>
